{
  "name": "freshloop-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.js",
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "lint": "eslint .",
    "waste-gate": "node --disable-warning=ExperimentalWarning scripts/waste-gate.js",
    "waste-gate:update": "node --disable-warning=ExperimentalWarning scripts/waste-gate.js --update-baseline",
    "screen-data": "node --disable-warning=ExperimentalWarning scripts/model.js screen",
    "train": "node --disable-warning=ExperimentalWarning scripts/model.js train",
    "monitor": "node --disable-warning=ExperimentalWarning scripts/model.js monitor",
    "sast": "eslint -c sast.config.js . --max-warnings 50",
    "test:coverage": "node --disable-warning=ExperimentalWarning --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=75 --test-coverage-functions=80 --test-coverage-exclude=test/** test/*.test.js",
    "dast": "node scripts/dast.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.0",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0",
    "supertest": "^7.3.2"
  },
  "engines": {
    "node": ">=22.13"
  }
}
